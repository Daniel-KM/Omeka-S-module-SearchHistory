<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \SearchHistory\Api\Representation\SearchRequestRepresentation[] $searchRequests
 */

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$assetUrl = $this->plugin('assetUrl');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');
$breadcrumbs = $plugins->has('breadcrumbs') ? $plugins->get('breadcrumbs') : null;
$user = $plugins->get('identity')();
$translatePlural = $plugins->get('translatePlural');
$guestNavigation = $user && $plugins->has('guestNavigation') ? $plugins->get('guestNavigation')() : null;

$hasGuestNav = $guestNavigation && $guestNavigation->getContainer()->count();

$this->headLink()
    ->appendStylesheet($assetUrl('css/common-dialog.css', 'Common'))
    ->appendStylesheet($assetUrl('css/search-history.css', 'SearchHistory'));
$this->headScript()
    ->appendFile($assetUrl('js/common-dialog.js', 'Common'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/search-history.js', 'SearchHistory'), 'text/javascript', ['defer' => 'defer']);

$this->htmlElement('body')->appendAttribute('class', 'search-request browse');

$escape = $plugins->get('escapeHtml');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$currentSortBy = $this->params()->fromQuery('sort_by', 'created');
$currentSortOrder = $this->params()->fromQuery('sort_order', 'desc');
$currentSort = $currentSortBy . '-' . $currentSortOrder;
$sortOptions = [
    'created-desc' => $translate('Date (descending)'), // @translate
    'created-asc' => $translate('Date (ascending)'), // @translate
    'comment-asc' => $translate('Title (ascending)'), // @translate
    'comment-desc' => $translate('Title (descending)'), // @translate
];
?>

<?php if ($breadcrumbs && !$hasGuestNav): ?>
<?= $breadcrumbs() ?>
<?php endif; ?>

<?php if ($hasGuestNav): ?>
<nav class="navigation-guest">
    <?= $guestNavigation->menu()->renderMenu() ?>
</nav>
<?php endif; ?>

<?= $this->messages() ?>

<?= $this->pageTitle($translate('Search History'), 2); ?>

<?= $this->searchFilters() ?>

<?php $totalResults = $this->pagination()->getPaginator()->getTotalCount(); ?>
<div class="browse-controls">
    <?= $this->pagination() ?>
    <div class="per-pages-and-sort">
        <span class="browse-total"><?= sprintf($translatePlural('%d saved search', '%d saved searches', $totalResults), $totalResults) ?></span>
        <label for="sort-search-history"><?= $translate('Sort by') ?></label>
        <select id="sort-search-history" onchange="var v=this.value.split('-'),p=new URLSearchParams(window.location.search);p.set('sort_by',v[0]);p.set('sort_order',v[1]);window.location.search=p;">
            <?php foreach ($sortOptions as $value => $label): ?>
            <option value="<?= $escapeAttr($value) ?>"<?= $value === $currentSort ? ' selected' : '' ?>><?= $escape($label) ?></option>
            <?php endforeach; ?>
        </select>
    </div>
</div>

<?php if (count($searchRequests)): ?>
<h3><?= sprintf($translatePlural('%d saved search', '%d saved searches', count($searchRequests)), count($searchRequests)) ?></h3>

<?php $this->trigger('view.browse.before'); ?>
<ul class="search-request-list">
<?php foreach ($searchRequests as $searchRequest): ?>
    <li class="search-request">
        <h4><?= $hyperlink($searchRequest->comment(), $searchRequest->originalUrl()) ?></h4>
        <?= $hyperlink($translate('Delete'), $url('site/search-history-id', ['action' => 'delete', 'id' => $searchRequest->id()], true), ['class' => 'search-history-delete']) ?>
    </li>
    <?php endforeach; ?>
</ul>
<?php $this->trigger('view.browse.after'); ?>
<?= $this->pagination() ?>

<?php else: ?>
<p>
    <?= $translate('No search requests are saved.') ?>
</p>
<?php endif; ?>

<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \SearchHistory\Api\Representation\SearchRequestRepresentation $searchRequest
 * @var string $engine
 * @var string $query
 * @var bool $removeInAccount
 */

if (!$engine) {
    return;
}

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$partial = $plugins->get('partial');
$assetUrl = $plugins->get('assetUrl');
$translate = $plugins->get('translate');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$this->headLink()
    ->appendStylesheet($assetUrl('css/common-dialog.css', 'Common'))
    ->appendStylesheet($assetUrl('css/search-history.css', 'SearchHistory'));
$this->headScript()
    ->appendFile($assetUrl('js/common-dialog.js', 'Common'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/search-history.js', 'SearchHistory'), 'text/javascript', ['defer' => 'defer']);
?>

<div class="search-history search-history-actions">

<?php if (!empty($removeInAccount) && $searchRequest): ?>

    <a class="button search-history-button search-history-link" href="<?= $url('site/guest/search-history', [], true) ?>">
        <span class="search-history-icon"><?= $translate('Search already saved') ?></span>
    </a>

<?php else: ?>

    <button type="button" class="button delete search-history-button search-history-delete <?= $searchRequest ? '' : ' hidden' ?>"
        data-url="<?= $searchRequest ? $escapeAttr($url('site/search-history-id', ['action' => 'delete', 'id' => $searchRequest->id()], true)) : '' ?>"
        data-heading="<?= $escapeAttr($translate('Save search')) ?>"
        data-msg-success="<?= $escapeAttr($translate('Search deleted from your account.')) ?>">
        <span class="search-history-icon"><?= $translate('Delete saved search') ?></span>
    </button>

<?php endif; ?>

    <button type="button" class="button add search-history-button search-history-save<?= $searchRequest ? ' hidden' : '' ?>"
        data-heading="<?= $escapeAttr($translate('Save search')) ?>"
        data-msg-success="<?= $escapeAttr($translate('Search saved in your account.')) ?>"
        data-msg-no-query="<?= $escapeAttr($translate('The current search has no query.')) ?>"
        data-msg-missing="<?= $escapeAttr($translate('Cannot save search: the dialog is missing.')) ?>">
        <span class="search-history-icon"><?= $translate('Save current search') ?></span>
    </button>
</div>

<?= $partial('common/dialog/search-history-save') ?>
